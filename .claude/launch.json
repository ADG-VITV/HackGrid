{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hackgrid-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "hackgrid-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": ["server.mjs"],
      "port": 3100,
      "env": { "NODE_ENV": "production", "PORT": "3100" }
    }
  ]
}
